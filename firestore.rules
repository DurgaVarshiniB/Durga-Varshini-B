rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny ALL
    match /{document=**} {
      allow read, write: if false;
    }

    // Basic helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Districts, Heroes, Stories, Quiz are public read
    match /districts/{districtId} { allow read: if true; }
    match /heroes/{heroId} { allow read: if true; }
    match /stories/{storyId} { allow read: if true; }
    match /quizQuestions/{questionId} { allow read: if true; }

    // User Progress: Only owner can read/write
    match /userProgress/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Connection test
    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
